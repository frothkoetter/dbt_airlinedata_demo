{"metadata": {"dbt_schema_version": "https://schemas.getdbt.com/dbt/run-results/v6.json", "dbt_version": "1.10.8", "generated_at": "2026-02-11T16:34:18.905664Z", "invocation_id": "ab363e66-535e-45fe-b399-567f7422323e", "invocation_started_at": "2026-02-11T16:30:45.760808Z", "env": {}}, "results": [{"status": "pass", "timing": [{"name": "compile", "started_at": "2026-02-11T16:30:56.092784Z", "completed_at": "2026-02-11T16:30:56.182426Z"}, {"name": "execute", "started_at": "2026-02-11T16:30:56.192708Z", "completed_at": "2026-02-11T16:32:01.846460Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 66.26486802101135, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.dbt_airlinedata.dbt_expectations_source_expect_table_row_count_to_be_between_raw_airlinedata_planes_csv_5000.6384afc167", "compiled": true, "compiled_code": "\n\n\n\n    with grouped_expression as (\n    select\n        \n        \n    \n  \n( 1=1 and count(*) >= 5000\n)\n as expression\n\n\n    from dbt_airlinedata_demo.planes_csv\n    \n\n),\nvalidation_errors as (\n\n    select\n        *\n    from\n        grouped_expression\n    where\n        not(expression = true)\n\n)\n\nselect *\nfrom validation_errors\n\n\n\n\n\n", "relation_name": null, "batch_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-02-11T16:32:02.382842Z", "completed_at": "2026-02-11T16:32:02.428372Z"}, {"name": "execute", "started_at": "2026-02-11T16:32:02.439595Z", "completed_at": "2026-02-11T16:33:00.642912Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 58.757572412490845, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.dbt_airlinedata.dbt_utils_source_not_null_proportion_raw_airlinedata_airlines_csv_0_95__description.d1f5b4e521", "compiled": true, "compiled_code": "\n\n\n\n\n\n\n\nwith validation as (\n  select\n    \n    sum(case when description is null then 0 else 1 end) / cast(count(*) as numeric) as not_null_proportion\n  from dbt_airlinedata_demo.airlines_csv\n  \n),\nvalidation_errors as (\n  select\n    \n    not_null_proportion\n  from validation\n  where not_null_proportion < 0.95 or not_null_proportion > 1\n)\nselect\n  *\nfrom validation_errors\n\n", "relation_name": null, "batch_results": null}, {"status": "fail", "timing": [{"name": "compile", "started_at": "2026-02-11T16:33:01.183081Z", "completed_at": "2026-02-11T16:33:01.215898Z"}, {"name": "execute", "started_at": "2026-02-11T16:33:01.226107Z", "completed_at": "2026-02-11T16:33:03.343010Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 2.643770933151245, "adapter_response": {"_message": "OK"}, "message": "Got 42 results, configured to fail if != 0", "failures": 42, "unique_id": "test.dbt_airlinedata.source_length_raw_airlinedata_airports_csv_iata__3.d40f2542cc", "compiled": true, "compiled_code": "\n\nwith validation as (\n\tselect iata as field\n\tfrom dbt_airlinedata_demo.airports_csv\n),\nvalidation_errors as (\n\tselect field from validation\n\twhere LENGTH(field) != 3\n)\n\nselect *\nfrom validation_errors\n\n", "relation_name": null, "batch_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-02-11T16:33:03.871495Z", "completed_at": "2026-02-11T16:33:03.907123Z"}, {"name": "execute", "started_at": "2026-02-11T16:33:03.918535Z", "completed_at": "2026-02-11T16:33:05.882941Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 2.497501850128174, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.dbt_airlinedata.source_not_null_raw_airlinedata_airlines_csv_code.648b08e0f8", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect code\nfrom dbt_airlinedata_demo.airlines_csv\nwhere code is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-02-11T16:33:06.412975Z", "completed_at": "2026-02-11T16:33:06.447513Z"}, {"name": "execute", "started_at": "2026-02-11T16:33:06.457739Z", "completed_at": "2026-02-11T16:33:08.553012Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 2.6154191493988037, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.dbt_airlinedata.source_not_null_raw_airlinedata_airports_csv_state.3a11e24593", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect state\nfrom dbt_airlinedata_demo.airports_csv\nwhere state is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-02-11T16:30:56.127922Z", "completed_at": "2026-02-11T16:30:56.189340Z"}, {"name": "execute", "started_at": "2026-02-11T16:30:56.219983Z", "completed_at": "2026-02-11T16:33:11.033189Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 135.43600273132324, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.dbt_airlinedata.dbt_utils_source_accepted_range_raw_airlinedata_flights_csv_year__2023__1995.9006493bfe", "compiled": true, "compiled_code": "\n\nwith meet_condition as(\n  select *\n  from dbt_airlinedata_demo.flights_csv\n),\n\nvalidation_errors as (\n  select *\n  from meet_condition\n  where\n    -- never true, defaults to an empty result set. Exists to ensure any combo of the `or` clauses below succeeds\n    1 = 2\n    -- records with a value >= min_value are permitted. The `not` flips this to find records that don't meet the rule.\n    or not year >= 1995\n    -- records with a value <= max_value are permitted. The `not` flips this to find records that don't meet the rule.\n    or not year <= 2023\n)\n\nselect *\nfrom validation_errors\n\n", "relation_name": null, "batch_results": null}, {"status": "warn", "timing": [{"name": "compile", "started_at": "2026-02-11T16:33:11.560127Z", "completed_at": "2026-02-11T16:33:11.596356Z"}, {"name": "execute", "started_at": "2026-02-11T16:33:11.607670Z", "completed_at": "2026-02-11T16:33:13.713142Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 2.6485300064086914, "adapter_response": {"_message": "OK"}, "message": "Got 373 results, configured to warn if >10", "failures": 373, "unique_id": "test.dbt_airlinedata.source_quotation_in_string_raw_airlinedata_airports_csv_airport.32b2406433", "compiled": true, "compiled_code": "\n\nwith validation as (\n\tselect airport as field\n\tfrom dbt_airlinedata_demo.airports_csv\n),\nvalidation_errors as (\n\tselect field from validation\n\twhere field rlike('\"')\n)\n\nselect *\nfrom validation_errors\n\n", "relation_name": null, "batch_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-02-11T16:33:14.253684Z", "completed_at": "2026-02-11T16:33:14.289372Z"}, {"name": "execute", "started_at": "2026-02-11T16:33:14.300983Z", "completed_at": "2026-02-11T16:33:16.282857Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 2.5131654739379883, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.dbt_airlinedata.source_row_count_between_raw_airlinedata_airports_csv_3500__3000.ccb75a52c5", "compiled": true, "compiled_code": "\n    with row_count as (\n        select count(*) as actual_row_count\n        from dbt_airlinedata_demo.airports_csv\n    )\n    select\n        case\n            when actual_row_count between 3000 and 3500 then 1\n            else 0\n        end as test_passes\n    from row_count\n    where (case\n\t\t\t\twhen actual_row_count between 3000 and 3500 then 1\n\t\t\t\telse 0 end ) = 0\n", "relation_name": null, "batch_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-02-11T16:33:16.809046Z", "completed_at": "2026-02-11T16:33:16.840455Z"}, {"name": "execute", "started_at": "2026-02-11T16:33:16.850368Z", "completed_at": "2026-02-11T16:33:18.863169Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 2.6175012588500977, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.dbt_airlinedata.source_row_count_with_warning_raw_airlinedata_airlines_csv_1500.b7e08d0eec", "compiled": true, "compiled_code": "\n    with row_count as (\n        select count(*) as actual_row_count\n        from dbt_airlinedata_demo.airlines_csv\n    ),\n    thresholds as (\n        select\n            1500 as expected_row_count,\n            1500 * 0.9 as lower_threshold,\n            1500 * 1.1 as upper_threshold\n    )\n    select\n        case\n            when actual_row_count >= lower_threshold and actual_row_count <= upper_threshold then 1\n            else 0\n        end as test_passes\n    from row_count, thresholds\n    where case\n        when actual_row_count >= lower_threshold and actual_row_count <= upper_threshold then 1\n        else 0\n    end = 0\n", "relation_name": null, "batch_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-02-11T16:33:19.469927Z", "completed_at": "2026-02-11T16:33:19.503260Z"}, {"name": "execute", "started_at": "2026-02-11T16:33:19.513393Z", "completed_at": "2026-02-11T16:33:21.522965Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 2.5404257774353027, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.dbt_airlinedata.source_unique_raw_airlinedata_airlines_csv_code.f07efa5f89", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    code as unique_field,\n    count(*) as n_records\n\nfrom dbt_airlinedata_demo.airlines_csv\nwhere code is not null\ngroup by code\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-02-11T16:33:22.051676Z", "completed_at": "2026-02-11T16:33:22.083545Z"}, {"name": "execute", "started_at": "2026-02-11T16:33:22.095013Z", "completed_at": "2026-02-11T16:33:24.133139Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 2.5553011894226074, "adapter_response": {"_message": "OK"}, "message"